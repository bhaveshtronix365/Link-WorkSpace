# Backend Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Live Workspace Backend API"
DEBUG=True

HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

SECRET_KEY=replace_with_secure_production_secret_key
JWT_SECRET=replace_with_secure_jwt_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_workspace

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Ticket Attachments & Limits
ATTACHMENT_ALLOWED_EXTENSIONS=[".png",".jpg",".jpeg",".webp",".gif",".pdf",".txt",".log",".csv",".json"]
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ATTACHMENT_MAX_FILES_PER_COMMENT=5
ATTACHMENT_MAX_FILES_PER_TICKET=50
ATTACHMENT_RATE_LIMIT_PER_MINUTE=30
ATTACHMENT_UPLOAD_DIR=./uploads/ticket_attachments
